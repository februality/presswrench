# Everything here is optional. `presswrench setup` (or `login`) is the
# normal way to sign in; the session lives in your OS keychain.

# Use a bearer token directly instead of the stored session (CI / containers).
# PRESSWRENCH_ACCESS_TOKEN=

# Local policy.
# PRESSWRENCH_READ_ONLY=1
# PRESSWRENCH_BLOCKED_OPERATIONS=delete_site

# SSH tuning.
# PRESSWRENCH_SSH_KEY_PATH=~/.ssh/presswrench
# PRESSWRENCH_SSH_KEY_LABEL=presswrench
# PRESSWRENCH_EXEC_TIMEOUT_MS=120000
# PRESSWRENCH_SSH_TIMEOUT_MS=30000
# PRESSWRENCH_CACHE_TTL_SECONDS=300
